{
  "name": "@seamlet/astro",
  "version": "0.1.0",
  "description": "Connects an Astro site to the Seamlet CMS: the schema of its content, the preview the editor frames, and its published content.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seamlet/sdk.git",
    "directory": "packages/astro"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./site": {
      "types": "./dist/site.d.ts",
      "default": "./dist/site.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./preview-requests": {
      "types": "./dist/preview-requests.d.ts",
      "default": "./dist/preview-requests.js"
    },
    "./routes/preview.astro": "./routes/preview.astro",
    "./routes/media": {
      "types": "./dist/routes/media.d.ts",
      "default": "./dist/routes/media.js"
    }
  },
  "files": [
    "dist",
    "routes"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "astro": ">=7.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/seamlet/sdk/tree/main/packages/astro#readme",
  "keywords": [
    "astro",
    "astro-integration",
    "cms",
    "visual-editing",
    "seamlet"
  ]
}
