---
// The pieces of one line of formatted text with their marks.
import { safeHref, type RichLine } from "@seamlet/astro/schema";

interface Props {
  readonly spans: RichLine;
}

const LINE_BREAK = "\n";

const { spans } = Astro.props;
const pieces = spans.map((span) => ({
  ...span,
  lines: span.text.split(LINE_BREAK),
  // Content is checked when it is saved; a site never renders an address a link may not have.
  safeHref: span.href === undefined ? undefined : safeHref(span.href),
}));
---

{pieces.map((piece) => {
  const words = piece.lines.map((line, index) => (
    <>
      {index > 0 && <br />}
      {line}
    </>
  ));
  const italic = piece.italic === true ? <em>{words}</em> : words;
  const bold = piece.bold === true ? <strong>{italic}</strong> : italic;
  return piece.safeHref === undefined ? (
    bold
  ) : (
    <a href={piece.safeHref}>{bold}</a>
  );
})}
