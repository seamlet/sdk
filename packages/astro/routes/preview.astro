---
// The preview the CMS's editor frames: a page of the site with the bridge to the editor.
// `/preview` is the first page, `/preview/menu` the page at /menu, `/preview/menu/latte` the page of
// a record. GET shows the published content; POST shows the content in its JSON body, never saved:
// the bridge renders the editor's draft this way.
import { parseContent } from "@seamlet/astro/schema";
import {
  isPageAddress,
  previewContentAt,
  previewHeadersOf,
  readDraft,
} from "@seamlet/astro/preview-requests";
import { cmsOrigin } from "virtual:seamlet/config";
import site from "virtual:seamlet/site";

const NOT_FOUND = 404;

const headers = previewHeadersOf(cmsOrigin);
for (const [name, value] of Object.entries(headers)) {
  Astro.response.headers.set(name, value);
}

const rest = Astro.params.page;
if (!isPageAddress(site.description, rest)) {
  return new Response(null, { status: NOT_FOUND, headers });
}
const reading =
  Astro.request.method === "POST" ? await readDraft(Astro.request) : undefined;
if (reading !== undefined && !reading.isRead) {
  return new Response(null, { status: reading.response.status, headers });
}
const content =
  reading === undefined
    ? previewContentAt(
        site.description,
        await site.loadPublishedContent(),
        rest,
      )
    : parseContent(site.schema, reading.draft).content;

const page = site.previewPageOf(rest, content);
if (page === undefined) {
  return new Response(null, { status: NOT_FOUND, headers });
}
const { component: Page, props } = page;
---

<Page {...props} />
