---
// The first page of the coffee shop: who they are, what is popular and what is coming up.
import { editable, safeHref } from "@seamlet/astro/schema";
import CoffeeShopLayout from "./CoffeeShopLayout.astro";
import { formatEventDate, hasWords } from "../format";
import RichText from "@seamlet/astro/components/RichText.astro";
import MenuList from "./MenuList.astro";
import RequestForm from "@seamlet/astro/components/RequestForm.astro";
import { tableForm } from "../forms";
import type { CoffeeShopContent } from "../schema";

interface Props {
  content: CoffeeShopContent;
}

const { content } = Astro.props;
const { hero, menu, event } = content;
// An event is announced only when both its title and its day are filled in.
const eventDate = event.title.trim() === "" ? null : event.date;
const signupHref =
  event.signup === null ? undefined : safeHref(event.signup.href);
const POPULAR_COUNT = 3;
const edit = editable<CoffeeShopContent>();
---

<CoffeeShopLayout content={content} title={hero.title} path="/">
  <header class="hero" {...edit("hero")}>
    <div class="hero-text">
      <h1 {...edit("hero", "title")}>{hero.title}</h1>
      {hasWords(hero.subtitle) && (
        <p class="subtitle" {...edit("hero", "subtitle")}>
          <RichText value={hero.subtitle} inline />
        </p>
      )}
    </div>
    {hero.photo !== null && (
      <img
        class="hero-photo"
        {...edit("hero", "photo")}
        src={hero.photo.src}
        alt={hero.photo.alt}
        width="800"
        height="600"
      />
    )}
  </header>

  <main>
    {menu.length > 0 && (
      <section class="menu" aria-labelledby="popular-heading">
        <h2 id="popular-heading" data-cms-fixed>
          Популярное
        </h2>
        <MenuList menu={menu} limit={POPULAR_COUNT} />
        <a class="more" href="/menu" data-cms-fixed>
          Всё меню →
        </a>
      </section>
    )}

    {eventDate !== null && (
      <section class="event" aria-labelledby="event-heading" {...edit("event")}>
        <p class="event-label" id="event-heading">
          Ближайшее событие
        </p>
        <p class="event-title" {...edit("event", "title")}>
          {event.title}
        </p>
        <time datetime={eventDate} {...edit("event", "date")}>
          {formatEventDate(eventDate)}
        </time>
        {signupHref !== undefined && (
          <a
            class="event-signup"
            href={signupHref}
            {...edit("event", "signup")}
          >
            {event.signup?.text || "Записаться"}
          </a>
        )}
      </section>
    )}

    <section class="booking" aria-labelledby="booking-heading">
      <h2 id="booking-heading" data-cms-fixed>
        Забронировать столик
      </h2>
      <RequestForm form={tableForm} submitLabel="Забронировать" />
    </section>
  </main>
</CoffeeShopLayout>

<style>
  .booking {
    max-width: 32rem;
    padding-block: 2rem 3rem;
  }

  .booking :global(.seamlet-form-field),
  .booking :global(.seamlet-form-consent) {
    display: grid;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }

  .booking :global(.seamlet-form-consent) {
    grid-template-columns: auto 1fr;
    align-items: start;
  }

  .booking :global(input:not([type="checkbox"])),
  .booking :global(textarea) {
    font: inherit;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--roast-muted);
    border-radius: 0.5rem;
  }

  .booking :global(.seamlet-form-issue) {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--roast);
    font-weight: 600;
  }

  .booking :global(.seamlet-form-submit) {
    font: inherit;
    padding: 0.75rem 1.5rem;
    border: 0;
    border-radius: 999px;
    background: var(--roast);
    color: var(--paper);
    cursor: pointer;
  }

  .hero,
  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .hero {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding-block: 2rem;
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 1fr 1fr;
      padding-block: 3rem;
    }
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
    line-height: 1.05;
  }

  .subtitle {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--roast-muted);
    white-space: pre-line;
  }

  .hero-photo {
    width: 100%;
    height: auto;
    border-radius: 1.5rem;
    background: var(--paper);
  }

  h2 {
    margin: 0 0 1.5rem;
    font-size: 1.75rem;
  }

  .menu {
    padding: 2rem 1.5rem;
    border-radius: 1.5rem;
    background: var(--paper);
  }

  .more {
    display: inline-block;
    margin-top: 1rem;
    color: var(--roast);
    font-weight: 600;
  }

  .event {
    margin-top: 2rem;
    padding: 1.5rem;
    border-radius: 1.5rem;
    background: var(--roast);
    color: var(--paper);
  }

  .event p {
    margin: 0;
  }

  .event-label {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .event-signup {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    background: var(--paper);
    color: var(--roast);
    font-weight: 700;
    text-decoration: none;
  }

  .event time {
    display: block;
  }

  .event-title {
    margin-block: 0.5rem !important;
    font-size: 1.5rem;
  }
</style>
