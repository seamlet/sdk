{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/capture/claude/raw/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.14.0 hook record || true",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.14.0 hook record || true",
            "async": true
          },
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.14.0 hook turn-start || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.14.0 hook record || true",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.14.0 hook record || true",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.14.0 hook record || true",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.14.0 hook record || true",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.14.0 hook record || true",
            "async": true
          },
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.14.0 hook stop || echo '{\"systemMessage\":\"Cyberzavod: the stop hook failed or could not start (for example, npx without network). Project checks were skipped.\"}'",
            "timeout": 180,
            "statusMessage": "Running project checks…"
          }
        ]
      }
    ]
  }
}
